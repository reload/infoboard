{
	skip_install_trust

	servers {
		# Trust the Traefik bridge network and read XFF header.
		trusted_proxies static 172.23.0.0/16
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	root /srv

	php_server {
		# PHP gets the direct peer (Traefik) as REMOTE_ADDR by default,
		# hand it the real client IP instead.
		env REMOTE_ADDR {client_ip}
	}
}
